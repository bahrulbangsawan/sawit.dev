#!/bin/sh
# Every push of main is a release (enable once per clone with
# `git config core.hooksPath .githooks`):
#   1. scripts/release.sh bumps the version, writes CHANGELOG.md, commits
#      "chore(release): vX" and tags vX;
#   2. once this push has finished, the release commit and tag are pushed
#      too (a hook can't add commits to the push already under way), with
#      any earlier release tag a failed push left behind (--follow-tags).
#      That push runs in the main working tree, with the common git folder,
#      and logs there, so it doesn't depend on the worktree main was pushed
#      from. A failure shows a notification;
#   3. the tag starts .github/workflows/release.yml, which builds the app
#      and publishes the GitHub Release the in-app updater reads.
# The release is cut on HEAD, so main is pushed from a checkout of main. A
# push of main from anywhere else would release nothing, so it is refused;
# SAWIT_SKIP_RELEASE=1 pushes it anyway, on purpose without a release.
set -eu
[ -z "${SAWIT_RELEASE_PUSH:-}${SAWIT_SKIP_RELEASE:-}" ] || exit 0
remote=$1

pushes_main=no
while read -r _ local_sha remote_ref _; do
    if [ "$remote_ref" = refs/heads/main ] && [ "$local_sha" != 0000000000000000000000000000000000000000 ]; then
        pushes_main=yes
    fi
done
[ "$pushes_main" = yes ] || exit 0

if branch=$(git symbolic-ref -q --short HEAD); then
    here="on $branch"
else
    here="on a detached HEAD"
fi
if [ "$here" != "on main" ]; then
    cat >&2 <<EOF
pre-push: a push of main is a release, cut on HEAD, but this checkout is $here,
pre-push: so it would release nothing. Nothing was pushed. Push main from a checkout of main:
pre-push:   git worktree add ../sawit-main main && git -C ../sawit-main push $remote main
pre-push:   git worktree remove ../sawit-main
pre-push: or push it without a release: SAWIT_SKIP_RELEASE=1 git push ...
EOF
    exit 1
fi

# Before the release is cut: should this fail, the push stops with nothing changed.
common=$(CDPATH='' cd "$(git rev-parse --git-common-dir)" && pwd -P)
main_tree=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
log=$common/sawit-release.log
tag=$(scripts/release.sh)
if [ -z "$tag" ]; then
    echo "pre-push: nothing new since the last release, so no release" >&2
    exit 0
fi

echo "pre-push: release $tag created; the release commit and tag are pushed once this push finishes (log: $log)" >&2
# Not from this checkout: a worktree main is pushed from may be removed as
# soon as this push returns, and its git folder (the GIT_DIR git gives this
# hook) with it. From the main working tree, which stays, with the common git
# folder: a remote at a relative path is found there as a push of main from
# the main checkout finds it.
cd "${main_tree:-$common}"
GIT_DIR=$common nohup sh -c '
    while kill -0 "$1" 2>/dev/null; do sleep 0.3; done
    if ! SAWIT_RELEASE_PUSH=1 git push --follow-tags "$2" main "$3"; then
        echo "pre-push: pushing release $3 failed. The next release push takes its tag along; to push it now: SAWIT_RELEASE_PUSH=1 git push --follow-tags $2 main"
        osascript -e "display notification \"Pushing release $3 failed. See $4\" with title \"Sawit release\"" >/dev/null 2>&1 || true
    fi
' sh "$PPID" "$remote" "$tag" "$log" >"$log" 2>&1 &
exit 0
