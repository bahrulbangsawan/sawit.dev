#!/bin/sh
# Every push of main is a release (enable once per clone with
# `git config core.hooksPath .githooks`):
#   1. scripts/release.sh bumps the version, writes CHANGELOG.md, commits
#      "chore(release): vX" and tags vX;
#   2. once this push has gone through, the release commit and tag are
#      pushed too (a hook can't add commits to the push already under way),
#      with any earlier release tag a failed push left behind (--follow-tags),
#      which a push of main with nothing new to release that goes through
#      sends too. That push runs in the main working tree, with the common
#      git folder, and logs there, so it doesn't depend on the worktree main
#      was pushed from. A failure shows a notification;
#   3. the tag starts .github/workflows/release.yml, which builds the app
#      and publishes the GitHub Release the in-app updater reads.
# The release is cut on HEAD, so main is pushed from a checkout of main. A
# push of main from anywhere else would release nothing, so it is refused;
# SAWIT_SKIP_RELEASE=1 pushes it anyway, on purpose without a release.
# Git runs this hook for `git push --dry-run` too, and doesn't say so: a dry
# run of main cuts the release here and pushes nothing, so the release stays
# here until the next push of main takes it along. To read the notes a push
# would publish, run scripts/release.sh --dry-run instead.
set -eu
[ -z "${SAWIT_RELEASE_PUSH:-}${SAWIT_SKIP_RELEASE:-}" ] || exit 0
remote=$1

main_sha=
while read -r _ local_sha remote_ref _; do
    if [ "$remote_ref" = refs/heads/main ] && [ "$local_sha" != 0000000000000000000000000000000000000000 ]; then
        main_sha=$local_sha
    fi
done
[ -n "$main_sha" ] || exit 0

if branch=$(git symbolic-ref -q --short HEAD); then
    here="on $branch"
else
    here="on a detached HEAD"
fi
if [ "$here" != "on main" ]; then
    # By its full path: the steps are run from wherever `git push` was typed.
    worktree="$(dirname "$(git rev-parse --show-toplevel)")/sawit-main"
    cat >&2 <<EOF
pre-push: a push of main is a release, cut on HEAD, but this checkout is $here,
pre-push: so it would release nothing. Nothing was pushed. Push main from a checkout of main:
pre-push:   git worktree add '$worktree' main
pre-push:   git -C '$worktree' push $remote main
pre-push: then, once git ls-remote --tags $remote lists the release tag that push names:
pre-push:   git worktree remove '$worktree'
pre-push: or push it without a release: SAWIT_SKIP_RELEASE=1 git push ...
EOF
    exit 1
fi

# Before the release is cut: should this fail, the push stops with nothing changed.
common=$(CDPATH='' cd "$(git rev-parse --git-common-dir)" && pwd -P)
main_tree=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
log=$common/sawit-release.log
tag=$(scripts/release.sh)
if [ -n "$tag" ]; then
    echo "pre-push: release $tag created; the release commit and tag are pushed once this push has gone through (log: $log)" >&2
    echo "pre-push: it is out once git ls-remote --tags $remote $tag lists the tag" >&2
else
    echo "pre-push: nothing new since the last release, so no release" >&2
    echo "pre-push: once this push has gone through, any release tag an earlier push left behind follows it (log: $log)" >&2
fi
# Not from this checkout: a worktree main is pushed from may be removed as
# soon as this push returns, and its git folder (the GIT_DIR git gives this
# hook) with it. From the main working tree, which stays, with the common git
# folder: a remote at a relative path is found there as a push of main from
# the main checkout finds it. The release, or the tags left behind, follow
# only a push of main that went through, not a dry run: such a push moved the
# remote-tracking main to what it pushed. A push to a URL moves none, so then
# the remote is asked.
cd "${main_tree:-$common}"
GIT_DIR=$common nohup sh -c '
    pid=$1 remote=$2 tag=$3 pushed=$4 log=$5
    while kill -0 "$pid" 2>/dev/null; do sleep 0.3; done
    landed=$(git rev-parse -q --verify "refs/remotes/$remote/main") ||
        landed=$(git ls-remote "$remote" refs/heads/main | while read -r sha ref; do
            [ "$ref" != refs/heads/main ] || echo "$sha"
        done)
    if [ "$landed" != "$pushed" ] && [ -z "$tag" ]; then
        echo "pre-push: main did not go out (a dry run, or a push that failed), so no release tag follows it"
        exit 0
    elif [ "$landed" != "$pushed" ]; then
        echo "pre-push: main did not go out (a dry run, or a push that failed), so release $tag stays here, unpushed. The next push of main takes it along; to push it now: SAWIT_RELEASE_PUSH=1 git push --follow-tags $remote main"
        osascript -e "display notification \"Release $tag was not pushed: main did not go out. See $log\" with title \"Sawit release\"" >/dev/null 2>&1 || true
        exit 0
    fi
    if [ -n "$tag" ]; then
        what="release $tag"
    else
        what="release tags"
    fi
    if ! SAWIT_RELEASE_PUSH=1 git push --follow-tags "$remote" main ${tag:+"$tag"}; then
        echo "pre-push: pushing $what failed. The next release push takes the tags left behind along; to push them now: SAWIT_RELEASE_PUSH=1 git push --follow-tags $remote main"
        osascript -e "display notification \"Pushing $what failed. See $log\" with title \"Sawit release\"" >/dev/null 2>&1 || true
    fi
' sh "$PPID" "$remote" "$tag" "$main_sha" "$log" >"$log" 2>&1 &
exit 0
